###shorthand variables
export zenitySmall="--height 500 --width 400"
export zenityMedium="--height 800 --width 400"
export zenityLarge="--width 5000"
export zenityTall="--height 5000"
export zenityFS="--height 5000 --width 5000"

###Timers to consult or log
export countFile="$RFo/count"
export tempCount="$RFo/tempcount"
export timerLog="$RFo/timers.log"
export reserveCount="$SFo/reservecount"

###Marvin
export list_file="/home/$USER/Sync/Notes/Organisation/todo_list.md"

export archiveMarvinFolder="/home/$USER/Documents/AmazingMarvinBackups"


###Timers shorthand variables
export timeCount=$(cat $countFile)
export timeTemp=$(cat $tempCount)
export timeReserve=$(cat $reserveCount)
export timeReserveHours=$(( $timeReserve / 3600 ))
export timeDisplay=$timeCount\ \($timeReserve\)
export timeDisplayNicer=$timeCount\ \($timeReserveHours\)

###Frequency of timer in seconds
export freq=5
export keybind=$(whatbindkeyisused.sh)

check_internet() {
    echo "Checking internet connectivity..."
    if ping -q -c 1 -W 1 duckduckgo.com > /dev/null; then
        echo "Connected to the internet."
        connected=true
    else
        echo "No internet connection. Please check your network settings."
        zenity --warning --text="No internet connection. Please check your network settings."
        connected=false
    fi
}

restart_timer() {
    #timer.sh -n &
    timer.sh &
    echo "Timer has been relaunched." >> $timerLog
}

addToTemp() {
    echo $(($timeTemp + $1)) > $tempCount
}
